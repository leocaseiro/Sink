{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sink",
  "main": ".output/server/index.mjs",
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public",
    "html_handling": "drop-trailing-slash"
  },
  "compatibility_date": "2025-05-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "keep_vars": true,
  "upload_source_maps": true,
  "vars": {
    "NUXT_REDIRECT_WITH_QUERY": "true" // append short-link query params to the destination URL by default (per-link override still works)
  },
  "observability": {
    "logs": {
      "enabled": true
    },
    "traces": {
      "enabled": true
    }
  },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "sink"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "preview_id": "f55967761ad94a6d990381ebdc6707dd",
      "id": "f55967761ad94a6d990381ebdc6707dd" // Your KV namespace (created via `wrangler kv namespace create KV`)
    }
  ],
  // R2 disabled — no payment card needed. Links auto-backup will go to GitHub instead (daily cron below).
  // To re-enable: enable R2 in the Cloudflare dashboard, run `wrangler r2 bucket create sink`, then uncomment:
  // "r2_buckets": [
  //   {
  //     "binding": "R2",
  //     "preview_bucket_name": "sink",
  //     "bucket_name": "sink"
  //   }
  // ],
  "triggers": {
    "crons": ["0 0 * * *"] // Run backup task daily at 00:00 UTC
  }
}
